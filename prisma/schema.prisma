generator client {
  provider      = "prisma-client-js"
  // native (local) + Render/Debian Linux
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentType {
  video
  article
  image

  @@map("content_type")
}

enum SpaceView {
  card
  list

  @@map("space_view")
}

enum JobStatus {
  pending
  processing
  completed
  failed

  @@map("job_status")
}

enum SpaceDiscoveryProfileStatus {
  active
  superseded
  failed

  @@map("space_discovery_profile_status")
}

model User {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String   @unique
  displayName String?  @map("display_name")
  themeMode   String   @default("light") @map("theme_mode")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  spaces      Space[]

  @@map("users")
}

model Space {
  id                String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String                  @map("user_id") @db.Uuid
  name              String
  description       String                  @default("")
  accent            String                  @default("ink")
  headerFont        String                  @default("SpaceGrotesk") @map("header_font")
  bgColor           String                  @default("") @map("bg_color")
  textColor         String                  @default("") @map("text_color")
  view              SpaceView               @default(card)
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  collections       Collection[]
  discoveryProfiles SpaceDiscoveryProfile[]

  @@index([userId], map: "idx_spaces_user_id")
  @@map("spaces")
}

model Job {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        String
  payload     Json      @map("payload_json") @db.JsonB
  status      JobStatus @default(pending)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3) @map("max_attempts")
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  lockedAt    DateTime? @map("locked_at") @db.Timestamptz(6)
  lockedBy    String?   @map("locked_by")
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  @@index([status, availableAt], map: "idx_jobs_status_available_at")
  @@index([type], map: "idx_jobs_type")
  @@map("jobs")
}

model SpaceDiscoveryProfile {
  id           String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  spaceId      String                       @map("space_id") @db.Uuid
  version      Int
  profile      Json                         @map("profile_json") @db.JsonB
  status       SpaceDiscoveryProfileStatus  @default(active)
  jobId        String?                      @unique @map("job_id") @db.Uuid
  createdAt    DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  supersededAt DateTime?                    @map("superseded_at") @db.Timestamptz(6)
  space        Space                        @relation(fields: [spaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([spaceId, version], map: "uq_space_discovery_profiles_space_version")
  @@index([spaceId, status], map: "idx_space_discovery_profiles_space_status")
  @@map("space_discovery_profiles")
}

model Collection {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  spaceId       String        @map("space_id") @db.Uuid
  name          String
  description   String        @default("")
  sortOrder     Int           @default(0) @map("sort_order")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  space         Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  gatherQueries GatherQuery[]
  contentItems  ContentItem[]

  @@index([spaceId], map: "idx_collections_space_id")
  @@map("collections")
}

model GatherQuery {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collectionId String     @map("collection_id") @db.Uuid
  query        String
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([collectionId], map: "idx_gather_queries_collection_id")
  @@map("gather_queries")
}

model Source {
  id           String              @id
  name         String
  provider     String
  description  String              @default("")
  priceCents   Int                 @map("price_cents")
  currency     String              @default("USD") @db.Char(3)
  billing      String              @default("monthly")
  accent       String
  isActive     Boolean             @default(true) @map("is_active")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  contentTypes SourceContentType[]
  contentItems ContentItem[]

  @@map("sources")
}

/// Content types each source can unlock (maps to `source_content_type`).
model SourceContentType {
  sourceId    String      @map("source_id")
  contentType ContentType @map("content_type")
  source      Source      @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([sourceId, contentType])
  @@map("source_content_type")
}

model ContentItem {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collectionId String      @map("collection_id") @db.Uuid
  sourceId     String      @map("source_id")
  type         ContentType
  title        String
  thumbnail    String      @default("")
  url          String?
  meta         String?
  sortOrder    Int         @default(0) @map("sort_order")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  collection   Collection  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  source       Source      @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([collectionId], map: "idx_content_items_collection_id")
  @@index([sourceId], map: "idx_content_items_source_id")
  @@index([collectionId, type], map: "idx_content_items_collection_type")
  @@map("content_items")
}
