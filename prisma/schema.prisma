generator client {
  provider      = "prisma-client-js"
  // native (local) + Render/Debian Linux
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SpaceView {
  card
  list

  @@map("space_view")
}

enum CollectionDiscoveryProfileStatus {
  active
  superseded

  @@map("collection_discovery_profile_status")
}

model User {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String   @unique
  displayName String?  @map("display_name")
  themeMode   String   @default("light") @map("theme_mode")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  spaces      Space[]

  @@map("users")
}

model Space {
  id                String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String                  @map("user_id") @db.Uuid
  name              String
  description       String                  @default("")
  accent            String                  @default("ink")
  headerFont        String                  @default("SpaceGrotesk") @map("header_font")
  bgColor           String                  @default("") @map("bg_color")
  textColor         String                  @default("") @map("text_color")
  view              SpaceView               @default(card)
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  collections       Collection[]

  @@index([userId], map: "idx_spaces_user_id")
  @@map("spaces")
}

model Collection {
  id                String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  spaceId           String                         @map("space_id") @db.Uuid
  name              String
  description       String                         @default("")
  sortOrder         Int                            @default(0) @map("sort_order")
  createdAt         DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  space             Space                          @relation(fields: [spaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  gatherQueries     GatherQuery[]
  discoveryProfiles CollectionDiscoveryProfile[]

  @@index([spaceId], map: "idx_collections_space_id")
  @@map("collections")
}

model CollectionDiscoveryProfile {
  id            String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collectionId  String                            @map("collection_id") @db.Uuid
  version       Int
  profile       Json                              @map("profile_json") @db.JsonB
  status        CollectionDiscoveryProfileStatus  @default(active)
  provider      String
  model         String
  promptVersion String                            @map("prompt_version")
  createdAt     DateTime                          @default(now()) @map("created_at") @db.Timestamptz(6)
  supersededAt  DateTime?                         @map("superseded_at") @db.Timestamptz(6)
  collection    Collection                        @relation(fields: [collectionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([collectionId, version], map: "uq_collection_discovery_profiles_collection_version")
  @@index([collectionId, status], map: "idx_collection_discovery_profiles_collection_status")
  @@map("collection_discovery_profiles")
}

model GatherQuery {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collectionId String     @map("collection_id") @db.Uuid
  query        String
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([collectionId], map: "idx_gather_queries_collection_id")
  @@map("gather_queries")
}
