DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
PORT=3000
NODE_ENV=development

# Worker / discovery
# OPENAI_API_KEY is optional. Without it, the worker uses a local heuristic generator.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
WORKER_POLL_INTERVAL_MS=2000

# Render / production deploy:
# API build: npm install --include=dev && npm run db:deploy && npm run build
# API start: npm run start:prod
# Worker start: npm run start:worker
