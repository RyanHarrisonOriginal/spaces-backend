DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
# Direct Neon URL (no PgBouncer). Required for BullMQ LISTEN/NOTIFY and schema migrations.
NEON_DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
PORT=3000
NODE_ENV=development

# Worker / discovery
# OPENAI_API_KEY is required for Collection discovery profile generation.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_DISCOVERY_MODEL="gpt-4o-mini"
WORKER_CONCURRENCY=2

# Render / production deploy:
# API build: npm install --include=dev && npm run db:deploy && npm run build
# API start: npm run start:prod
# Worker start: npm run start:worker
# Set NEON_DIRECT_DATABASE_URL to the Neon direct (non-pooler) connection string.
